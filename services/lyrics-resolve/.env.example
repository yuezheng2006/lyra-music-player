# Comma-separated API keys. If unset, temporary hardcoded key "dev-key" is used.
# LYRICS_RESOLVE_API_KEYS=dev-key

# HTTP listen port
LYRICS_RESOLVE_PORT=3010

# Netease Cloud Music API (same as player VITE_NETEASE_API_BASE)
NETEASE_API_BASE=http://127.0.0.1:3001

# Optional QQ cookie for official lyric endpoints
# QQ_MUSIC_COOKIE=
# QQ_MUSIC_UIN=

# Set to 1 to enable /v1/lyrics/search and /v1/lyrics/by-id
# LYRICS_RESOLVE_DEBUG=1
